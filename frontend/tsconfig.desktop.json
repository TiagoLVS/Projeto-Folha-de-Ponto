{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "plugins": [],
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ]
    }
  },
  "include": [
    "../windows-app/frontend/**/*.tsx",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "hooks/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "lib/backend-proxy.ts"
  ]
}
