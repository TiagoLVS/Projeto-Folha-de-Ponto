# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Tesseract
TESSERACT_CMD=
OCR_LANG=por

# E-mail: credenciais abaixo utilizadas no modo de teste e em utilitários.
# Na interface em modo real, cada computador informa a própria conta e senha SMTP.
DIGEP_EMAIL=
DIGEP_SENHA_APP=
DIGEP_MODO_TESTE=true

# Upload
MAX_UPLOAD_BYTES=15728640

# CORS
CORS_ORIGINS=http://localhost:5173

# SMTP institucional ou Gmail. ssl (465) ou starttls (normalmente 587).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
# No modo de teste/utilitários, SMTP_USER/SMTP_PASSWORD vazios usam DIGEP_EMAIL/DIGEP_SENHA_APP.
# Host, porta e segurança também se aplicam às contas conectadas pela interface.

# Lotes de modelos institucionais (reinicie o backend após alterar).
MAX_GENERATION_BATCH=500
MAX_GENERATED_DOWNLOAD_BATCH=500
# Soma dos PDFs descompactados e tamanho final do ZIP: 250 MiB.
MAX_GENERATED_ZIP_BYTES=262144000

# Proteção das contas SMTP persistidas: chave Fernet, nunca armazenada no banco.
# Por padrão é criada automaticamente em .secrets/email.key (faça backup separado).
# EMAIL_CREDENTIALS_KEY_FILE=/caminho/seguro/email.key
# Alternativa: EMAIL_CREDENTIALS_KEY=<chave Fernet gerada pelo cryptography>
