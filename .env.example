# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Tesseract
TESSERACT_CMD=
OCR_LANG=por

# E-mail
DIGEP_EMAIL=
DIGEP_SENHA_APP=
DIGEP_MODO_TESTE=true

# Upload
MAX_UPLOAD_BYTES=15728640

# CORS
CORS_ORIGINS=http://localhost:5173

# SMTP institucional ou Gmail. ssl (465) ou starttls (normalmente 587).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
# SMTP_USER/SMTP_PASSWORD vazios usam DIGEP_EMAIL/DIGEP_SENHA_APP.

# Lotes de modelos institucionais (reinicie o backend após alterar).
MAX_GENERATION_BATCH=500
MAX_GENERATED_DOWNLOAD_BATCH=500
# Soma dos PDFs descompactados e tamanho final do ZIP: 250 MiB.
MAX_GENERATED_ZIP_BYTES=262144000
